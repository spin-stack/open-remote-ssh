{
	"name": "spinbox-remote",
	"displayName": "Spinbox Remote",
	"description": "Opens Spinbox workspaces in VS Code: the spin+<workspace> remote, through the spin CLI.",
	"version": "2.0.0",
	"publisher": "spin-stack",
	"license": "MIT",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/spin-stack/open-remote-ssh"
	},
	"bugs": {
		"url": "https://github.com/spin-stack/open-remote-ssh/issues"
	},
	"packageManager": "pnpm@11.27.1",
	"engines": {
		"vscode": "^1.146.0"
	},
	"main": "./lib/extension.js",
	"scripts": {
		"build": "node esbuild.mjs",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write --error-on-warnings .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "vitest run --config vitest.e2e.config.mts",
		"package": "vsce package --no-dependencies --out spinbox-remote.vsix"
	},
	"dependencies": {
		"ssh2": "1.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "22.20.5",
		"@types/ssh2": "0.5.52",
		"@types/ssh2-streams": "0.1.13",
		"@types/vscode": "1.146.0",
		"@vscode/vsce": "4.1.0",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"activationEvents": [
		"onResolveRemoteAuthority:spin"
	],
	"contributes": {
		"configuration": {
			"title": "Spinbox Remote",
			"properties": {
				"remote.spin.cliPath": {
					"type": "string",
					"markdownDescription": "The spin CLI that opens Spinbox workspaces (`spin+<workspace>`). Empty runs the one the Spinbox extension carries, or else `spin` on the PATH.",
					"scope": "machine",
					"default": ""
				}
			}
		},
		"commands": [
			{
				"command": "spinremote.showLog",
				"title": "Show Connection Log",
				"category": "Spinbox"
			}
		],
		"resourceLabelFormatters": [
			{
				"scheme": "vscode-remote",
				"authority": "spin+*",
				"formatting": {
					"label": "${path}",
					"separator": "/",
					"tildify": true,
					"workspaceSuffix": "Spinbox"
				}
			}
		],
		"menus": {
			"statusBar/remoteIndicator": [
				{
					"command": "spinremote.showLog",
					"when": "remoteName == spin",
					"group": "remote_20_spin_1general@1"
				}
			]
		}
	},
	"icon": "resources/icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"remote",
		"remote development",
		"spinbox"
	],
	"api": "none",
	"enabledApiProposals": [
		"resolvers"
	],
	"extensionKind": [
		"ui"
	]
}
