+// jeanp413/ssh2@a169f62's "Fix sigSSHToASN1": a big-endian integer as a DER
+// INTEGER - a zero in front when the high bit is set, and no zeros that do not
+// carry the sign.
+function convertToMpint(buf) {
+  const prependZeroCount = buf[0] & 0x80 ? 1 : 0;
+  let skipZeroCount = 0;
+  for (let i = 0; i < buf.length - 1 && buf[i] === 0; i++) {
+    if ((buf[i + 1] & 0x80) === 0)
+      skipZeroCount++;
+  }
+  const newBuf = Buffer.allocUnsafe(
+    buf.length + prependZeroCount - skipZeroCount
+  );
+  buf.copy(newBuf, prependZeroCount, skipZeroCount, buf.length);
+  if (prependZeroCount)
+    newBuf[0] = 0;
+  return newBuf;
+}
