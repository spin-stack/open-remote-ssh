{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  // Lint only: recommended holds every file, warnings included (package.json's lint), but for
  // the rules below, which are a style the code is not written in rather than a defect. The
  // formatter is off, and imports keep the order they are written in.
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useImportType": "off"
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "files": {
    // src/typings is VS Code's proposed API, copied as Microsoft wrote it.
    "includes": ["**", "!**/*.md", "!**/*.yaml", "!**/*.yml", "!!src/typings"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
